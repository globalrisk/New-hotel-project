# Supabase project credentials (Dashboard → Project Settings → API)
# Copy this file to .env and fill in your values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cursor MCP only (NOT used by the Vite app). Create a token at:
# https://supabase.com/dashboard/account/tokens
# Then copy .cursor/mcp.json.example → .cursor/mcp.json and paste the token there.
# YOUR_PROJECT_REF is the subdomain from VITE_SUPABASE_URL (before .supabase.co).
